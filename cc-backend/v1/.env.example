# Database Configuration
# For local development, use localhost:5432
# For Docker, use db:5432
DATABASE_URL=postgresql://ccdev:dev@localhost:5432/cc

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-django
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API Keys (optional for basic functionality)
PLAYFLY_API_KEY=
FACEIT_API_KEY=
NWES_API_KEY=
DISCORD_WEBHOOK_URL=
# Separate channel for backend warnings/errors (leave empty to disable)
DISCORD_ALERTS_WEBHOOK_URL=

# Firebase Configuration (optional - leave empty for dev mode bypass)
# When DJANGO_DEBUG=True and this is empty, you can use "Bearer dev" token
GOOGLE_APPLICATION_CREDENTIALS=

# Picture storage (optional - see README "Image storage"). Leave empty in dev:
# uploads return 503 and pictures keep their original URLs.
IMAGE_STORAGE_BUCKET=
IMAGE_CDN_BASE_URL=
IMAGE_STORAGE_REGION=us-east-1
# DigitalOcean Spaces only: endpoint, and public-read so its CDN can serve files
IMAGE_STORAGE_ENDPOINT_URL=
IMAGE_STORAGE_ACL=
IMAGE_AWS_ACCESS_KEY_ID=
IMAGE_AWS_SECRET_ACCESS_KEY=
